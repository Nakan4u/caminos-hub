# Template for the .env that lives on the VPS at /opt/caminos-hub/.env
# (never committed — copy this file there and fill in real values).
# See DEPLOY.md for the full one-time setup.

# The domain Caddy requests a Let's Encrypt certificate for and proxies to
# the app. Must already point at the VPS's IP (DNS A record) before startup.
DOMAIN=your-domain.example

# Postgres container credentials (the `db` service below reads these
# directly; DATABASE_URL below must match them).
POSTGRES_USER=caminohub
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caminohub

# `db` is the Postgres service's name on the internal Compose network —
# not localhost, not the VPS's public IP.
DATABASE_URL=postgresql://caminohub:change-me@db:5432/caminohub

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=https://your-domain.example

# Google OAuth client — see README "Google sign-in setup". Add the prod
# redirect URI (https://your-domain.example/api/auth/callback/google) to
# the same Google Cloud Console client used for local dev, or create a
# separate prod client.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
