generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MODERATE
  HARD
}

enum RouteListStatus {
  PLANNED
  COMPLETED
}

model Route {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  nameEs      String
  totalKm     Int
  typicalDays Int
  difficulty  Difficulty
  countries   String[]
  popularity  Int
  isUnesco    Boolean    @default(false)
  stages      Stage[]
  translations RouteTranslation[]
  userRoutes  UserRoute[]

  @@index([totalKm])
  @@index([difficulty])
}

model Stage {
  id         Int     @id @default(autoincrement())
  routeId    Int
  route      Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order      Int
  distanceKm Float
  ascentM    Int?
  fromPlace  String
  toPlace    String
  notes      String?

  @@unique([routeId, order])
  @@index([routeId])
}

model RouteTranslation {
  id          Int    @id @default(autoincrement())
  routeId     Int
  route       Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  locale      String
  name        String?
  summary     String?
  description String?
  startPlace  String?
  endPlace    String?
  waymarking  String?
  bestSeason  String?

  @@unique([routeId, locale])
  @@index([locale])
}

// --- Auth.js (NextAuth v5) ---------------------------------------------------
// User/Account/Session use `String @default(cuid())` PKs per the Auth.js adapter
// contract, a deliberate departure from this schema's `Int autoincrement` style.
// Session and VerificationToken are unused under `session: { strategy: 'jwt' }`
// (forced by the Credentials provider) but kept so `PrismaAdapter(prisma)` stays
// type-clean and email flows stay cheap to add later.

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  // Uploaded avatar, stored in-row (see docs/superpowers/specs/2026-08-28-user-settings-page-design.md).
  // `image` above still holds the Google profile-picture URL; `imageData` wins when set.
  imageData      Bytes?
  imageType      String?
  imageUpdatedAt DateTime?
  accounts      Account[]
  sessions      Session[]
  routes        UserRoute[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserRoute {
  id      Int             @id @default(autoincrement())
  userId  String
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  routeId Int
  route   Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  status  RouteListStatus

  @@unique([userId, routeId])
  @@index([userId, status])
  @@index([routeId])
}
