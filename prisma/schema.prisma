generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MODERATE
  HARD
}

model Route {
  id          Int        @id @default(autoincrement())
  slug        String     @unique
  nameEs      String
  totalKm     Int
  typicalDays Int
  difficulty  Difficulty
  countries   String[]
  popularity  Int
  isUnesco    Boolean    @default(false)
  stages      Stage[]
  translations RouteTranslation[]

  @@index([totalKm])
  @@index([difficulty])
}

model Stage {
  id         Int     @id @default(autoincrement())
  routeId    Int
  route      Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  order      Int
  distanceKm Float
  ascentM    Int?
  translations StageTranslation[]

  @@unique([routeId, order])
  @@index([routeId])
}

model RouteTranslation {
  id          Int    @id @default(autoincrement())
  routeId     Int
  route       Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)
  locale      String
  name        String?
  summary     String?
  description String?
  startPlace  String?
  endPlace    String?
  waymarking  String?
  bestSeason  String?

  @@unique([routeId, locale])
  @@index([locale])
}

model StageTranslation {
  id        Int    @id @default(autoincrement())
  stageId   Int
  stage     Stage  @relation(fields: [stageId], references: [id], onDelete: Cascade)
  locale    String
  fromPlace String?
  toPlace   String?
  notes     String?

  @@unique([stageId, locale])
  @@index([locale])
}
